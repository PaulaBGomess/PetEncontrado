# PostgreSQL
POSTGRES_USER=petuser
POSTGRES_PASSWORD=petpass
POSTGRES_DB=petencontrado
DATABASE_URL=postgresql://petuser:petpass@localhost:5432/petencontrado?schema=public

# API
PORT=3333
API_URL=http://localhost:3333
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=troque-por-uma-chave-access-com-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=troque-por-uma-chave-refresh-diferente-e-com-pelo-menos-32-caracteres
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
NODE_ENV=development

# Recuperacao de senha por e-mail (exemplo Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
MAIL_FROM="PetEncontrado <seu-email@gmail.com>"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/api/v1/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_CALLBACK_URL=http://localhost:3333/api/v1/auth/facebook/callback

# Web
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
